[Unit]
Description=Rustdesk Signal Server

[Service]
Type=simple
LimitNOFILE=1000000
Environment="RUST_LOG_LEVEL=trace"
WorkingDirectory=/opt/rustdesk-server/lib/

ExecStartPre=/bin/sh -c 'rm -rf /opt/rustdesk-server/lib/*'
ExecStart=/opt/rustdesk-server/amd64/hbbs
ExecStartPost=/opt/rustdesk-server/generate-rustdesk-bat.sh

StandardOutput=append:/var/log/rustdesk-server/hbbs.log
StandardError=append:/var/log/rustdesk-server/hbbs.error

Restart=always
RestartSec=10

User=root
Group=root

# Security
ProtectSystem=full
ReadWritePaths=/opt/rustdesk-server/lib/
ReadWritePaths=/var/log/rustdesk-server/
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectClock=yes
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
